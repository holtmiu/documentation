  "keyFeatures": [
    "Scenario-driven adversarial test generation for AI agents",
    "Real agent execution via Codex SDK, HTTP, and adapter providers",
    "10-category risk taxonomy covering prompt injection, secret handling, sandbox escape, network egress, and more",
    "Dataset subscriptions from HarmBench, JBB, ToxicChat, ALERT, and 10+ catalogs",
    "Trace-aware judging that inspects commands, file reads, tool calls, and network events",
    "Multi-model comparison across generator, target, judge, and baseline roles",
    "Preflight validation of target reachability and scenario quality",
    "Comprehensive HTML/JSON/Markdown reporting with reproducibility artifacts",
    "Go web service API for asynchronous batch attack generation",
    "Target Lab controlled environments via Inspect and benchmark adapters"
  ],
  "publicApiSurface": [
    "promptbeat validate --config <file>",
    "promptbeat generate --config <file> --output-dir <dir>",
    "promptbeat eval --config <file> --output-dir <dir>",
    "promptbeat report --eval-result <file>",
    "POST /api/v1/attack/preview",
    "POST /api/v1/attack/task/create",
    "GET /api/v1/attack/task/{taskId}",
    "Provider: openai:codex-sdk",
    "Provider: openai:<model>",
    "Provider: anthropic:<model>",
    "Provider: http:<endpoint>",
    "DatasetSpec YAML",
    "Scenario YAML (risk, failure_criteria, judge_strategy)",
    "Seed YAML",
    "Target YAML (name, description, capabilities)",
    "promptbeat.yaml (project config)",
    "subscriptions/*.yaml (dataset subscription plans)"
  ]
